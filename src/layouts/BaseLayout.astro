---
import SiteHeader from "../components/site-header/SiteHeader.astro";
import "../styles/main.scss";

type Props = {
  title?: string;
  description?: string;
  currentPath?: string;
};

const { currentPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.url.origin);
const ogImage = new URL("/images/og.png", Astro.url.origin);
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      fetchpriority="low"
      src="https://www.googletagmanager.com/gtag/js?id=G-V8C2P15644"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        window.dataLayer.push(args);
      }
      gtag("js", new Date());

      gtag("config", "G-V8C2P15644");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="大規模Webサイトの設計・実装・品質管理と、フロントエンドチームのリードに強みを持つ遠藤勇気のポートフォリオサイトです。"
    />
    <meta name="theme-color" content="#f7f8f5" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content="Yuki Endo" />
    <meta
      property="og:description"
      content="大規模Webサイトの設計・実装・品質管理と、フロントエンドチームのリードに強みを持つ遠藤勇気のポートフォリオサイトです。"
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YUKI ENDO / FRONTEND ENGINEER" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="/images/favicon.png"
      type="image/png"
      sizes="32x32"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400..600&display=swap"
    />
    <title>Yuki Endo</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="site-footer__identity">YUKI ENDO / FRONTEND ENGINEER</p>
      <nav class="site-footer__nav" aria-label="フッターナビゲーション">
        <a class="site-footer__link" href="/#profile">Profile</a>
        <a class="site-footer__link" href="/#career">Career</a>
        <a class="site-footer__link" href="/#works">Works</a>
        <a class="site-footer__link" href="/#contact">Contact</a>
      </nav>
      <p class="site-footer__copyright">© {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>
