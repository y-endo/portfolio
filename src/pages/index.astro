---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/hero-scene/HeroScene.astro';
import ProfileSection from '../components/profile-section/ProfileSection.astro';
import CareerList from '../components/career-list/CareerList.astro';
import WorkFeature from '../components/work-feature/WorkFeature.astro';
import LinksSection from '../components/links-section/LinksSection.astro';
import ContactSection from '../components/contact-section/ContactSection.astro';
import { works } from '../data/works';
import '../styles/pages/home.scss';
---

<BaseLayout>
  <HeroScene>
    <div
      class="p-home-shot p-home-shot--right js-journey-shot"
      data-shot="profile"
      data-picture="/assets/img/img_profile_portrait.webp"
    >
      <ProfileSection />
    </div>
    <CareerList />
    <section class="p-home-works" id="works" aria-labelledby="works-title">
      {
        works.map((work, index) => (
          <div
            class:list={[
              'p-home-shot',
              'p-home-shot--work',
              'js-journey-shot',
              { 'p-home-shot--short': index < works.length - 1 },
            ]}
            data-shot={'works-' + String(index + 1)}
            data-screen-title={work.title}
            data-screen-image={work.cover.src}
          >
            <div class="p-home-panel p-home-works__panel js-journey-content">
              {index === 0 && (
                <>
                  <h2 class="p-home-panel__title p-home-works__title js-journey-title" id="works-title">
                    Works
                  </h2>
                  <p class="p-home-works__lead">※個人開発の制作物のみを掲載しております。</p>
                </>
              )}
              <WorkFeature work={work} index={index} />
            </div>
          </div>
        ))
      }
    </section>
    <div class="p-home-shot js-journey-shot" data-shot="kitchen">
      <LinksSection />
    </div>
    <div class="p-home-shot p-home-shot--last js-journey-shot" data-shot="contact">
      <ContactSection />
    </div>
  </HeroScene>
</BaseLayout>
