---
import { ArrowUpRight } from '@lucide/astro';
import type { Work } from '../../data/works';
import './work-feature.scss';
type Props = { work: Work; index: number };
const { work, index } = Astro.props;
const target = 'work-' + String(index + 1);
---

<article class="p-home-work" aria-labelledby={target + '-title'}>
  <p class="p-home-work__caption">{work.number} / {work.category} / {work.year}</p>
  <a class="p-home-work__media" href={'/works/' + work.slug + '/'} aria-label={work.title + 'の詳細を見る'}>
    <img
      class="p-home-work__image"
      src={work.cover.src}
      width={work.cover.width}
      height={work.cover.height}
      alt={work.cover.alt}
      loading="lazy"
      decoding="async"
    />
    <span class="p-home-work__image-label">VIEW PROJECT <ArrowUpRight class="p-home-work__image-arrow" /></span>
  </a>
  <h3 class="p-home-work__title" id={target + '-title'}>{work.title}</h3>
  <p class="p-home-work__summary">{work.summary}</p>
  <p class="p-home-work__role">{work.role}</p>
  <a class="p-home-link" href={'/works/' + work.slug + '/'}
    ><span>プロジェクトを見る</span><ArrowUpRight class="p-home-link__icon" /></a
  >
  <details class="p-home-work__details">
    <summary class="p-home-work__details-toggle">担当範囲・取り組みを読む <span aria-hidden="true">+</span></summary>
    <dl class="p-home-work__facts">
      {
        [
          ['課題', work.challenge],
          ['役割', work.role],
          ['担当範囲', work.scope],
          ['実現したこと', work.outcome],
        ].map(([label, value]) => (
          <div class="p-home-work__fact">
            <>
              <dt class="p-home-work__fact-label">{label}</dt>
              <dd class="p-home-work__fact-value">{value}</dd>
            </>
          </div>
        ))
      }
      {
        work.url && (
          <div class="p-home-work__fact">
            <>
              <dt class="p-home-work__fact-label">公開URL</dt>
              <dd class="p-home-work__fact-value">
                <a class="text-link" href={work.url} target="_blank" rel="noreferrer">
                  {work.url}
                </a>
              </dd>
            </>
          </div>
        )
      }
    </dl>
  </details>
</article>
