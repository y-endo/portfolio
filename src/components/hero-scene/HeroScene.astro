---
import { chapters } from '../../data/chapters';
import './hero-scene.scss';
---

<section class="m-hero-scene m-hero-scene--loading js-hero-scene" id="top" aria-labelledby="hero-title">
  <div class="m-hero-scene__viewport js-hero-viewport">
    <div class="m-hero-scene__stage js-hero-stage">
      <img
        class="m-hero-scene__poster"
        src="/assets/img/img_hero_avatar.webp"
        alt=""
        width="800"
        height="800"
        decoding="async"
      />
      <canvas class="m-hero-scene__canvas js-hero-canvas" aria-hidden="true"></canvas>
      <span class="m-hero-scene__grade" aria-hidden="true"></span>
      <span class="m-hero-scene__veil" aria-hidden="true"></span>
    </div>
    <div class="m-hero-scene__introduction js-hero-introduction">
      <h1 class="m-hero-scene__title js-journey-title" id="hero-title">
        <span class="m-hero-scene__name">Yuki Endo</span>
        <span class="m-hero-scene__portfolio">Portfolio</span>
      </h1>
      <p class="m-hero-scene__discipline">Frontend Engineer</p>
    </div>
    <div class="m-hero-scene__loader js-hero-loader" aria-hidden="true">
      <div class="m-hero-scene__loader-meter">
        <p class="m-hero-scene__loader-head">
          <span class="m-hero-scene__loader-count js-hero-loader-percent">0</span>
          <span class="m-hero-scene__loader-unit">%</span>
        </p>
        <span class="m-hero-scene__loader-track"><span class="m-hero-scene__loader-bar"></span></span>
      </div>
    </div>
    <p class="m-hero-scene__status js-hero-status" role="status"></p>
    <div class="m-hero-scene__footer">
      <a class="m-hero-scene__scroll js-journey-next" href="#profile"
        ><span class="js-journey-next-label">Scroll to explore</span>
        <span class="m-hero-scene__scroll-icon" aria-hidden="true"></span></a
      >
      <p class="m-hero-scene__room js-journey-label">The study</p>
    </div>
    <span class="m-hero-scene__progress" aria-hidden="true"></span>
    <nav class="m-hero-scene__rail" aria-label="章の進み具合">
      <span class="m-hero-scene__rail-line" aria-hidden="true"><span class="m-hero-scene__rail-fill"></span></span>
      <ol class="m-hero-scene__rail-list">
        {
          chapters.map((chapter, index) => (
            <li class="m-hero-scene__rail-item">
              <a class="m-hero-scene__rail-link js-house-nav-link js-journey-rail-link" href={'#' + chapter.id}>
                <span class="m-hero-scene__rail-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="m-hero-scene__rail-label">
                  <span class="m-hero-scene__rail-label-text">{chapter.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
  <div class="m-hero-scene__travel" aria-hidden="true"></div>
  <div class="m-hero-scene__destination js-hero-destination"><slot /></div>
</section>

<script>
  import { initHeroScene } from '../../scripts/hero-scene';
  initHeroScene();
</script>
