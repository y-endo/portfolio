---
import { career } from '../../data/career';
import './career-list.scss';
---

<section class="p-home-panel p-home-career js-journey-content" id="career" aria-labelledby="career-title">
  <p class="p-home-panel__eyebrow">03 / The living room</p>
  <h2 class="p-home-panel__title js-journey-title" id="career-title">Career</h2>
  <p class="p-home-career__intro">2014年から、設計・開発・運用、そしてチームのリードへ。</p>
  <ol class="p-home-career__timeline" reversed>
    {
      career.map((entry, index) => (
        <li class="p-home-career__entry">
          <p class="p-home-career__period">{entry.period}</p>
          <h3 class="p-home-career__organization">{entry.organization}</h3>
          <p class="p-home-career__role">{entry.role}</p>
          <details class="p-home-career__details" open={index === 0}>
            <summary class="p-home-career__toggle">
              この期間の取り組み <span aria-hidden="true">+</span>
            </summary>
            <p class="p-home-career__summary">{entry.summary}</p>
          </details>
        </li>
      ))
    }
  </ol>
</section>
