---
import './section-heading.scss';

type Props = {
  index: string;
  title: string;
  id: string;
  titleClassName?: string;
};
const { index, title, id, titleClassName } = Astro.props;
---

<header class="section-heading">
  <h2 class="section-heading__title" id={id}>
    <span class:list={['section-heading__text', titleClassName]}>{title}</span>
  </h2>
  <span class="section-heading__index" aria-hidden="true">{index}</span>
</header>
