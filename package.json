{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "pnpm lint && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:eslint && pnpm lint:styles && pnpm lint:markdown",
    "lint:eslint": "eslint . --no-error-on-unmatched-pattern",
    "lint:styles": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix --allow-empty-input && markdownlint-cli2 --fix \"**/*.md\" && prettier --write ."
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/three": "0.185.4",
    "astro": "7.1.6",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sass": "1.102.0",
    "sharp": "0.35.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "@lucide/astro": "1.28.0",
    "swiper": "14.0.7",
    "three": "0.185.1"
  }
}
